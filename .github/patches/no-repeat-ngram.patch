+// no-repeat-ngram
+
+// bans a token if appending it would re-create an n-gram that already occurred in the
+// accepted history. same semantics as `no_repeat_ngram_size` in transformers / SGLang.
+//
+// the difference to the penalties and to DRY: those penalize any long-enough repeat, which
+// also damages legitimate repeated content (table cells, boilerplate, headers) and is what
+// makes them unusable for OCR-style output. here only a fully repeated n-gram is blocked.
+struct llama_sampler_no_repeat_ngram {
+    using ngram_key = std::vector<llama_token>;
+
+    struct ngram_key_hash {
+        size_t operator()(const ngram_key & key) const {
+            // FNV-1a: cheap, and the map still compares the keys exactly - a hash collision
+            // can only cost a little time, it can never ban a wrong token
+            uint64_t h = 1469598103934665603ULL;
+            for (const llama_token token : key) {
+                h ^= (uint64_t) (uint32_t) token;
+                h *= 1099511628211ULL;
+            }
+            return (size_t) h;
+        }
+    };
+
+    // for each (n_gram - 1)-gram in the history: how many times each token followed it
+    using followers = std::unordered_map<llama_token, int32_t>;
+
+    const int32_t n_gram;
+    const int32_t window;
+
+    // accepted tokens, at most `window` of them
+    std::deque<llama_token> hist;
+
+    // the (n_gram - 1)-grams of `hist`, in the order of their start position: keys[i] == hist[i .. i + n_gram - 2]
+    std::deque<ngram_key> keys;
+
+    std::unordered_map<ngram_key, followers, ngram_key_hash> next;
+
+    void copy_state(const llama_sampler_no_repeat_ngram & src) {
+        hist = src.hist;
+        keys = src.keys;
+        next = src.next;
+    }
+
+    llama_sampler_no_repeat_ngram(int32_t n_gram, int32_t window) : n_gram(n_gram), window(window) {
+    }
+};
+
+static const char * llama_sampler_no_repeat_ngram_name(const struct llama_sampler * /*smpl*/) {
+    return "no-repeat-ngram";
+}
+
+static void llama_sampler_no_repeat_ngram_accept(struct llama_sampler * smpl, llama_token token) {
+    auto * ctx = (llama_sampler_no_repeat_ngram *) smpl->ctx;
+
+    ctx->hist.push_back(token);
+
+    if ((int32_t) ctx->hist.size() >= ctx->n_gram) {
+        llama_sampler_no_repeat_ngram::ngram_key key(ctx->hist.end() - ctx->n_gram, ctx->hist.end() - 1);
+
+        ctx->next[key][token]++;
+
+        ctx->keys.push_back(std::move(key));
+    }
+
+    // keep the history bounded: drop the oldest token together with the n-gram that started at it
+    while ((int32_t) ctx->hist.size() > ctx->window) {
+        GGML_ASSERT(!ctx->keys.empty());
+        GGML_ASSERT((int32_t) ctx->keys.size() == (int32_t) ctx->hist.size() - ctx->n_gram + 1);
+
+        const auto it = ctx->next.find(ctx->keys.front());
+        GGML_ASSERT(it != ctx->next.end());
+
+        // the token that followed the oldest n-gram
+        const llama_token following = ctx->hist[ctx->n_gram - 1];
+
+        auto & cur = it->second;
+        if (--cur[following] == 0) {
+            cur.erase(following);
+        }
+        if (cur.empty()) {
+            ctx->next.erase(it);
+        }
+
+        ctx->keys.pop_front();
+        ctx->hist.pop_front();
+    }
+}
+
+static void llama_sampler_no_repeat_ngram_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_no_repeat_ngram *) smpl->ctx;
+
+    const int32_t n_key = ctx->n_gram - 1;
+
+    if (cur_p->size <= 1 || (int32_t) ctx->hist.size() < n_key) {
+        return;
+    }
+
+    const llama_sampler_no_repeat_ngram::ngram_key key(ctx->hist.end() - n_key, ctx->hist.end());
+
+    const auto it = ctx->next.find(key);
+    if (it == ctx->next.end()) {
+        return;
+    }
+
+    const auto & banned = it->second;
+
+    // never ban the whole candidate set - there would be nothing left to sample from
+    size_t n_allowed = 0;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        n_allowed += banned.find(cur_p->data[i].id) == banned.end() ? 1 : 0;
+    }
+    if (n_allowed == 0) {
+        return;
+    }
+
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        if (banned.find(cur_p->data[i].id) != banned.end()) {
+            cur_p->data[i].logit = -INFINITY;
+        }
+    }
+
+    cur_p->sorted = false;
+}
+
+static void llama_sampler_no_repeat_ngram_reset(struct llama_sampler * smpl) {
+    auto * ctx = (llama_sampler_no_repeat_ngram *) smpl->ctx;
+
+    ctx->hist.clear();
+    ctx->keys.clear();
+    ctx->next.clear();
+}
+
+static struct llama_sampler * llama_sampler_no_repeat_ngram_clone(const struct llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_no_repeat_ngram *) smpl->ctx;
+
+    auto * result = llama_sampler_init_no_repeat_ngram(ctx->n_gram, ctx->window);
+
+    auto * result_ctx = (llama_sampler_no_repeat_ngram *) result->ctx;
+
+    result_ctx->copy_state(*ctx);
+
+    return result;
+}
+
+static void llama_sampler_no_repeat_ngram_free(struct llama_sampler * smpl) {
+    delete (llama_sampler_no_repeat_ngram *) smpl->ctx;
+}
+
+static struct llama_sampler_i llama_sampler_no_repeat_ngram_i = {
+    /* .name              = */ llama_sampler_no_repeat_ngram_name,
+    /* .accept            = */ llama_sampler_no_repeat_ngram_accept,
+    /* .apply             = */ llama_sampler_no_repeat_ngram_apply,
+    /* .reset             = */ llama_sampler_no_repeat_ngram_reset,
+    /* .clone             = */ llama_sampler_no_repeat_ngram_clone,
+    /* .free              = */ llama_sampler_no_repeat_ngram_free,
+    /* .backend_init      = */ nullptr, // needs the whole accepted history -> CPU only
+    /* .backend_accept    = */ nullptr,
+    /* .backend_apply     = */ nullptr,
+    /* .backend_set_input = */ nullptr,
+    /* .backend_reset     = */ nullptr,
+    /* .copy_state        = */ llama_sampler_backend_copy_state<llama_sampler_no_repeat_ngram>,
+};
+
+struct llama_sampler * llama_sampler_init_no_repeat_ngram(int32_t n_gram, int32_t window) {
+    const bool is_empty = n_gram <= 0 || window < n_gram;
+
+    if (is_empty) {
+        return llama_sampler_init_empty("?no-repeat-ngram");
+    }
+
+    return llama_sampler_init(
+        /* .iface = */ &llama_sampler_no_repeat_ngram_i,
+        /* .ctx   = */ new llama_sampler_no_repeat_ngram(n_gram, window)
+    );
+}
