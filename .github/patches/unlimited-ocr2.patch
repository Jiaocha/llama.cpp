+// multimodal calibration (--mmproj): every line of the -f file is "<image>[,<image>...]<TAB><target text file>"
+// the images are evaluated as "<PAGE><image>"... + "Multi page parsing." (Unlimited-OCR prompt layout),
+// then the target text (e.g. the reference model's OCR output) is teacher-forced
+static bool compute_imatrix_mtmd(llama_context * ctx, const common_params & params, const int32_t n_ctx) {
+    const llama_model * model = llama_get_model(ctx);
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    mtmd_context_params mparams = mtmd_context_params_default();
+    mparams.use_gpu          = params.mmproj_use_gpu;
+    mparams.n_threads        = params.cpuparams.n_threads;
+    mparams.print_timings    = false;
+    mparams.image_max_tokens = params.image_max_tokens;
+    mtmd::context_ptr mctx(mtmd_init_from_file(params.mmproj.path.c_str(), model, mparams));
+    if (!mctx) {
+        LOG_ERR("%s: failed to load mmproj '%s'\n", __func__, params.mmproj.path.c_str());
+        return false;
+    }
+
+    std::ifstream fin(params.prompt_file);
+    if (!fin) {
+        LOG_ERR("%s: failed to open '%s'\n", __func__, params.prompt_file.c_str());
+        return false;
+    }
+
+    auto read_file = [](const std::string & path, std::string & out) {
+        std::ifstream f(path, std::ios::binary);
+        if (!f) {
+            return false;
+        }
+        out.assign(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());
+        return true;
+    };
+
+    const mtmd_helper_init_opt init_opt = mtmd_helper_init_opt_default();
+    int n_docs = 0;
+    std::string line;
+    while (std::getline(fin, line)) {
+        if (!line.empty() && line.back() == '\r') {
+            line.pop_back();
+        }
+        const size_t tab = line.find('\t');
+        if (line.empty() || tab == std::string::npos) {
+            continue;
+        }
+        const std::vector<std::string> images = string_split<std::string>(line.substr(0, tab), ',');
+        std::string target;
+        if (!read_file(line.substr(tab + 1), target)) {
+            LOG_ERR("%s: cannot read target '%s'\n", __func__, line.substr(tab + 1).c_str());
+            return false;
+        }
+
+        mtmd::bitmaps bitmaps;
+        std::string prompt;
+        for (const auto & img : images) {
+            auto res = mtmd_helper_bitmap_init_from_file(mctx.get(), img.c_str(), false, init_opt);
+            if (!res.bitmap) {
+                LOG_ERR("%s: cannot load image '%s'\n", __func__, img.c_str());
+                return false;
+            }
+            bitmaps.entries.emplace_back(res.bitmap);
+            prompt += std::string("<PAGE>") + mtmd_default_marker();
+        }
+        prompt += "Multi page parsing.";
+
+        mtmd::input_chunks chunks(mtmd_input_chunks_init());
+        mtmd_input_text text = { prompt.c_str(), prompt.size(), /*add_special*/ true, /*parse_special*/ true };
+        auto bitmaps_c = bitmaps.c_ptr();
+        if (mtmd_tokenize(mctx.get(), chunks.ptr.get(), &text, bitmaps_c.data(), bitmaps_c.size()) != 0) {
+            LOG_ERR("%s: tokenization failed for '%s'\n", __func__, line.c_str());
+            return false;
+        }
+
+        llama_memory_clear(llama_get_memory(ctx), true);
+
+        const auto t_start = std::chrono::high_resolution_clock::now();
+        llama_pos n_past = 0;
+        if (mtmd_helper_eval_chunks(mctx.get(), ctx, chunks.ptr.get(), 0, 0, params.n_batch, false, &n_past) != 0) {
+            LOG_ERR("%s: failed to evaluate the prompt of '%s'\n", __func__, line.c_str());
+            return false;
+        }
+
+        std::vector<llama_token> tokens = common_tokenize(vocab, target, false, true);
+        tokens.push_back(llama_vocab_eos(vocab));
+        if ((int64_t) tokens.size() > n_ctx - n_past) {
+            tokens.resize(std::max<int64_t>(0, n_ctx - n_past));
+        }
+        for (size_t i = 0; i < tokens.size(); i += params.n_batch) {
+            const int32_t n = std::min<int32_t>(params.n_batch, (int32_t) (tokens.size() - i));
+            if (llama_decode(ctx, llama_batch_get_one(tokens.data() + i, n)) != 0) {
+                LOG_ERR("%s: failed to decode the target of '%s'\n", __func__, line.c_str());
+                return false;
+            }
+        }
+
+        const float t = std::chrono::duration<float>(std::chrono::high_resolution_clock::now() - t_start).count();
+        LOG_INF("%s: [%d] %s: %d prompt + %zu target tokens, %.1f s\n", __func__, ++n_docs, line.substr(0, tab).c_str(), (int) n_past, tokens.size(), t);
+
+    }
+
+    return n_docs > 0;
+}
