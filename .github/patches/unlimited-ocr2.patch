     const llama_vocab * vocab = llama_model_get_vocab(model);
@@ -2036,7 +2144,9 @@ int main(int argc, char ** argv) {
         LOG_INF("%s\n", common_params_get_system_info(params).c_str());
     }
 
-    if (!compute_imatrix(ctx, params, n_ctx, nextn.get())) { return 1; }
+    if (!params.mmproj.path.empty()) {
+        if (!compute_imatrix_mtmd(ctx, params, n_ctx)) { return 1; }
+    } else if (!compute_imatrix(ctx, params, n_ctx, nextn.get())) { return 1; }
 
     g_collector.save_imatrix();
 
